# Postgres (your in-house DB on DigitalOcean). Without it the site still runs:
# the feed is fetched live and cached in memory; sign-ups return a friendly error.
DATABASE_URL=postgres://user:password@localhost:5432/bigstocks

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="BigStocks admin@yourdomain.com"

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=https://bigstocks.com

# SMS text alerts: provider-neutral. Pick one:
#   console  - default; logs texts instead of sending (dev / before a vendor is chosen)
#   webhook  - POSTs each text to your own service (any vendor). See lib/sms/providers/webhook.ts
#   twilio   - built-in example adapter. See lib/sms/providers/twilio.ts
# New vendors: add a file in lib/sms/providers and register it in lib/sms/index.ts.
SMS_PROVIDER=console
# SMS_WEBHOOK_URL=https://your-sms-service.internal/send
# SMS_WEBHOOK_SECRET=long-random-string-at-least-16-chars
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_MESSAGING_SERVICE_SID=
# SMS_RATE_PER_SEC=10   # broadcast speed; match your provider throughput

# Track record API: your alert system logs alerts with this key (16+ chars)
ALERTS_API_KEY=

# Email notifications (new Advertise-form requests go to your team)
#   console - default; logs the email instead of sending
#   smtp    - any SMTP service: Google Workspace, Microsoft 365, Amazon SES, SendGrid, Postmark, Mailgun...
#   webhook - POSTs each email to your own service. See lib/email/providers/webhook.ts
EMAIL_PROVIDER=console
INQUIRY_NOTIFY_TO=sales@yourdomain.com
EMAIL_FROM="BigStocks <no-reply@yourdomain.com>"
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_WEBHOOK_URL= / EMAIL_WEBHOOK_SECRET=
