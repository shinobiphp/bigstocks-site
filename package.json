{
  "name": "bigstocks-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "ingest:once": "tsx --env-file=.env scripts/ingest.ts --once",
    "test": "tsx scripts/test-parsers.ts",
    "sms:broadcast": "tsx --env-file=.env scripts/sms-broadcast.ts",
    "db:init": "node --env-file=.env -e \"const{Pool}=require('pg');new Pool({connectionString:process.env.DATABASE_URL}).query(require('fs').readFileSync('db/schema.sql','utf8')).then(()=>{console.log('schema ok');process.exit(0)},e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "cobe": "0.6.5",
    "fast-xml-parser": "5.11.2",
    "next": "15.5.28",
    "nodemailer": "10.2.1",
    "pg": "8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
